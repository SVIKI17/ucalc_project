FROM python:3.12-slim
LABEL maintainer="ucalc_project"

WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY ucalc_api/ucalc_requirements.txt /src/ucalc_api/ucalc_requirements.txt
RUN pip install --no-cache-dir -r ucalc_api/ucalc_requirements.txt

COPY ucalc_api /src/ucalc_api
COPY ucalc_web /src/ucalc_web

EXPOSE 8200

CMD ["sh", "-c", "uvicorn ucalc_api.ucalc_api:app --host 0.0.0.0 --port ${PORT:-8200}"]